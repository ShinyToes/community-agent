# Chat-completions-compatible endpoint; no model name is assumed.
RESEARCH_BASE_URL=
RESEARCH_API_KEY=
RESEARCH_MODEL=

# Optional embeddings backend: remote (default) or fastembed (local ONNX).
# For fastembed, first download the model explicitly with tools/prepare_local_embedding.py.
RESEARCH_EMBEDDING_BACKEND=
# Remote backend only:
RESEARCH_EMBEDDING_BASE_URL=
RESEARCH_EMBEDDING_API_KEY=
# Local backend defaults to BAAI/bge-small-zh-v1.5 when blank.
RESEARCH_EMBEDDING_MODEL=
